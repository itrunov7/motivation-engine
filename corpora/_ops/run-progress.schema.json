{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventora.dev/motivation-engine/run-progress.schema.json",
  "title": "Run progress heartbeat (D-086)",
  "description": "The live progress heartbeat a long-running Actions job (evidence harvest, extraction) writes after each checkpoint. A publisher force-pushes it to the dedicated `ops-progress` git ref every ~2 minutes so /ops can show live progress. This file NEVER lives on main — it exists at runtime only on the ops-progress ref (single-file orphan tree) and in the job's gitignored .ops-progress/ working dir. Mirrors lib/types.ts RunProgress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "target",
    "phase",
    "github_run_id",
    "github_run_attempt",
    "dispatch_id",
    "started_at",
    "updated_at",
    "finished",
    "status",
    "progress",
    "records",
    "spend",
    "caps",
    "note"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "enum": ["harvest", "extraction"] },
    "target": { "type": ["string", "null"] },
    "phase": { "type": "string" },
    "github_run_id": { "type": ["integer", "null"] },
    "github_run_attempt": { "type": ["integer", "null"] },
    "dispatch_id": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "finished": { "type": "boolean" },
    "status": { "enum": ["running", "success", "partial", "failed"] },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "done", "total"],
      "properties": {
        "unit": { "enum": ["queries", "batches"] },
        "done": { "type": "integer", "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "records": { "type": ["integer", "null"], "minimum": 0 },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_calls", "tokens_in", "tokens_out", "estimated_usd"],
      "properties": {
        "api_calls": { "type": ["integer", "null"], "minimum": 0 },
        "tokens_in": { "type": ["integer", "null"], "minimum": 0 },
        "tokens_out": { "type": ["integer", "null"], "minimum": 0 },
        "estimated_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_run_calls", "per_run_tokens", "monthly_calls", "monthly_usd"],
      "properties": {
        "per_run_calls": { "type": ["integer", "null"], "minimum": 0 },
        "per_run_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "monthly_calls": { "type": ["integer", "null"], "minimum": 0 },
        "monthly_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "note": { "type": ["string", "null"] },
    "summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "proposed",
        "merged",
        "dropped_ungrounded",
        "failed_validation",
        "held_low_confidence",
        "dropped_volume_cap",
        "dropped_volume_cap_high_confidence",
        "candidates",
        "records_eligible",
        "records_relevant",
        "records_processed",
        "records_skipped_irrelevant",
        "records_remaining"
      ],
      "properties": {
        "proposed": { "type": "integer", "minimum": 0 },
        "merged": { "type": "integer", "minimum": 0 },
        "dropped_ungrounded": { "type": "integer", "minimum": 0 },
        "failed_validation": { "type": "integer", "minimum": 0 },
        "held_low_confidence": { "type": "integer", "minimum": 0 },
        "dropped_volume_cap": { "type": "integer", "minimum": 0 },
        "dropped_volume_cap_high_confidence": { "type": "integer", "minimum": 0 },
        "candidates": { "type": "integer", "minimum": 0 },
        "records_eligible": { "type": "integer", "minimum": 0 },
        "records_relevant": { "type": "integer", "minimum": 0 },
        "records_processed": { "type": "integer", "minimum": 0 },
        "records_skipped_irrelevant": { "type": "integer", "minimum": 0 },
        "records_remaining": { "type": "integer", "minimum": 0 },
        "records_selected": {
          "description": "Records the planner kept across every slice of the run (D-103). Optional; absent means the run predates D-103, not that nothing was selected.",
          "type": "integer",
          "minimum": 0
        },
        "records_dropped_truncation": {
          "description": "Relevant records the planner dropped to fit limits.per_run_tokens (D-103). Truncation stays as the enforcement mechanism; silence about it does not. Optional; absent means the run predates D-103.",
          "type": "integer",
          "minimum": 0
        },
        "candidates_cheap": { "type": "integer", "minimum": 0 },
        "candidates_strong": { "type": "integer", "minimum": 0 },
        "dropped_ungrounded_cheap": { "type": "integer", "minimum": 0 },
        "dropped_ungrounded_strong": { "type": "integer", "minimum": 0 },
        "dropped_ungrounded_reasons": {
          "description": "Per-reason attribution of dropped_ungrounded (D-098). Keys are the grounding checks that refused a candidate; values sum to dropped_ungrounded. Optional: absent on a clean run and on runs written before D-098.",
          "$ref": "#/$defs/ungroundedReasons"
        },
        "dropped_ungrounded_reasons_cheap": {
          "description": "The same attribution for the cheap extraction pass alone (D-105) — the only pass that reads the source records. Optional; absent on runs written before D-105.",
          "$ref": "#/$defs/ungroundedReasons"
        },
        "dropped_ungrounded_reasons_strong": {
          "description": "The same attribution for the strong synthesis pass alone (D-105). Optional; absent on runs written before D-105.",
          "$ref": "#/$defs/ungroundedReasons"
        }
      }
    }
  },
  "$defs": {
    "ungroundedReasons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "no_citations": { "type": "integer", "minimum": 0 },
        "malformed_citation": { "type": "integer", "minimum": 0 },
        "unknown_record_id": { "type": "integer", "minimum": 0 },
        "quote_not_in_source": { "type": "integer", "minimum": 0 },
        "wrong_corpus_kind": { "type": "integer", "minimum": 0 },
        "doi_unresolved": { "type": "integer", "minimum": 0 },
        "title_mismatch": { "type": "integer", "minimum": 0 },
        "provenance_mismatch": { "type": "integer", "minimum": 0 },
        "span_role_missing": { "type": "integer", "minimum": 0 },
        "span_role_not_finding": { "type": "integer", "minimum": 0 },
        "span_role_contradicted_by_structure": { "type": "integer", "minimum": 0 },
        "premise_contradicted_downstream": { "type": "integer", "minimum": 0 },
        "proposal_not_built": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
