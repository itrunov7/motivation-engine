# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated cards (render-cards.ts output)
# NOTE: keep tracked once generated per SPEC; ignore only local scratch
# /cards/

# misc
.DS_Store
*.pem

# ephemeral dry-run quote (D-025): a run artifact, never committed
/quote.json

# live run-progress heartbeat (D-086): a working file the publisher force-pushes
# to the ops-progress ref, never committed to main
/.ops-progress/

# drafting scratch for registry records and dossiers. Declared scratch because
# the validator reads registry/mechanisms and registry/mechanisms/_seed ONLY, so
# anything here is schema-shaped data that no gate checks — the drafts left from
# the S7 batch-2 promotion were byte-identical to the committed records, which is
# exactly the kind of near-duplicate that gets edited by mistake.
/registry/temp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (auth: ACCESS_PASSWORD, SESSION_SECRET)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.idea/
