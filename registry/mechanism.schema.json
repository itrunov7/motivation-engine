{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventora.dev/motivation-engine/mechanism.schema.json",
  "title": "Mechanism (L1 record)",
  "description": "Full L1 mechanism record per SPEC.md §3.2. Hard rules: implementations[].metrics non-empty and constraints.hard_rules non-empty, otherwise the record is INVALID. Seed stubs use $defs.seedStub instead.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2}-\\d{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "level": { "const": "L1" },
    "parent": {
      "type": "string",
      "pattern": "^S[1-7]$",
      "description": "L0 taxonomy node id"
    },
    "cross_cutting": {
      "type": "boolean",
      "description": "A record under a cross-cutting L0 node (D-062, e.g. S7) applies to every generated element, not to specific funnel stages. Optional; absent === false."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["candidate", "incubating", "core", "deprecated", "rejected"]
    },
    "dossier_ref": {
      "type": ["string", "null"],
      "description": "Path to the dossier record when it exists; null until then"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "proposed_by": {
          "type": "string",
          "enum": ["owner", "derivation-pipeline"]
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": ["proposed_by", "date"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "grade": { "type": "string", "enum": ["A+", "A", "A-", "B+", "B", "B-", "C+", "C", "C-"] },
        "basis": { "type": "string", "minLength": 1 },
        "effect_size_note": { "type": "string" },
        "caveats": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["grade", "basis", "effect_size_note", "caveats"],
      "additionalProperties": false
    },
    "evidence_terms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Owner-provided search terms for the evidence connector (D-015). Must include disconfirming and boundary-condition terms, not only confirming ones — a corpus that can only confirm is methodologically broken. Optional; the connector falls back to [name] when absent."
    },
    "pinned_evidence": {
      "type": "array",
      "description": "Owner-pinned works the connector cannot reliably surface (D-017). The evidence connector merges these into the corpus (source_api: pinned), fetching metadata from OpenAlex by DOI. 100% recall is a human+machine contract, not a query-tuning goal.",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "doi": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["title", "doi", "reason"],
        "additionalProperties": false
      }
    },
    "orthogonality_note": {
      "type": "string",
      "minLength": 1,
      "description": "Optional top-level annotation explaining why two distinct phenomena are bundled as one L1, or a managed-overlap note. Owner-authored content (D-042)."
    },
    "prior_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mechanism_summary_for_context": {
      "type": "string",
      "minLength": 1,
      "description": "The text future generation will consume"
    },
    "applicability": {
      "type": "object",
      "properties": {
        "funnel_stages": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "excluded_stages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifact_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactType" },
          "minItems": 1
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "predicate": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["predicate", "reason"],
            "additionalProperties": false
          }
        },
        "culture_note": { "type": "string" }
      },
      "required": ["funnel_stages", "excluded_stages", "artifact_types", "preconditions", "culture_note"],
      "additionalProperties": false
    },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "artifact_types": {
            "type": "array",
            "items": { "$ref": "#/$defs/artifactType" },
            "minItems": 1
          },
          "product_requirements": {
            "type": "array",
            "items": { "type": "string" }
          },
          "generation_directive": { "type": "string", "minLength": 1 },
          "copy_formulas": {
            "type": "array",
            "items": { "type": "string" }
          },
          "metrics": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "HARD RULE: must be non-empty, otherwise the record is invalid"
          },
          "observed_effects": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "artifact_types", "product_requirements", "generation_directive", "copy_formulas", "metrics", "observed_effects"],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "hard_rules": {
          "type": "array",
          "minItems": 1,
          "description": "HARD RULE: must be non-empty, otherwise the record is invalid",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "rule": { "type": "string", "minLength": 1 },
              "severity": { "type": "string", "enum": ["block", "warn"] }
            },
            "required": ["id", "rule", "severity"],
            "additionalProperties": false
          }
        },
        "compliance_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "boundary_test": { "type": "string" }
      },
      "required": ["hard_rules", "compliance_refs", "boundary_test"],
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["enabled_by", "enables", "adjacent", "hybrid_with", "orthogonality_note"]
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Z]{2}-\\d{2}$"
          },
          "note": { "type": "string" }
        },
        "required": ["type", "target", "note"],
        "additionalProperties": false
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "tag_format": { "type": "string", "minLength": 1 },
        "amplitude_event_property": { "type": "string", "minLength": 1 }
      },
      "required": ["tag_format", "amplitude_event_property"],
      "additionalProperties": false
    },
    "reference_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product": { "type": "string", "minLength": 1 },
          "what": { "type": "string", "minLength": 1 }
        },
        "required": ["product", "what"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "slug",
    "name",
    "version",
    "level",
    "parent",
    "lifecycle_status",
    "dossier_ref",
    "provenance",
    "evidence",
    "prior_weight",
    "mechanism_summary_for_context",
    "applicability",
    "implementations",
    "constraints",
    "relations",
    "telemetry"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifactType": {
      "type": "string",
      "enum": [
        "paywall",
        "cancellation_flow",
        "retention_push",
        "checkout",
        "email",
        "pricing_page",
        "dashboard_widget",
        "onboarding",
        "landing_hero"
      ]
    },
    "seedStub": {
      "title": "Seed mechanism stub (reduced shape)",
      "description": "Lax sub-schema for candidate seed stubs in /registry/mechanisms/_seed/. Stubs contain ONLY these fields; content is owner-provided and never fleshed out until a dossier moves them through the gate. grade_draft is a free-form draft grade (e.g. A, B+, A-), not the strict A|B|C evidence grade.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2}-\\d{2}$"
        },
        "name": { "type": "string", "minLength": 1 },
        "grade_draft": { "type": "string", "minLength": 1 },
        "oneliner": { "type": "string", "minLength": 1 },
        "parent": {
          "type": "string",
          "pattern": "^S[1-7]$"
        },
        "lifecycle_status": { "const": "candidate" },
        "cross_cutting": {
          "type": "boolean",
          "description": "A stub under a cross-cutting L0 node (D-062) applies to every generated element, not to specific funnel stages. Optional; absent === false."
        },
        "evidence_terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Owner-provided search terms for the evidence connector (D-015), permitted on a stub so a candidate can be harvested before it is fleshed out. Must include disconfirming and boundary-condition terms, not only confirming ones. Optional; the connector falls back to [name] when absent."
        },
        "pinned_evidence": {
          "type": "array",
          "description": "Owner-pinned works the connector cannot reliably surface (D-017), permitted on a stub. The evidence connector merges these into the corpus (source_api: pinned), fetching metadata from OpenAlex by DOI.",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "doi": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "required": ["title", "doi", "reason"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id", "name", "grade_draft", "oneliner", "parent", "lifecycle_status"],
      "additionalProperties": false
    }
  }
}
