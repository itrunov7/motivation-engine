{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ventora.dev/motivation-engine/proposal.schema.json",
  "title": "Knowledge proposal",
  "description": "The universal provenance-gated envelope for proposed knowledge. Files live at proposals/{type}/{id}.json and have no effect on authoritative artifacts until owner approval.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "effect",
        "realization",
        "interaction",
        "mechanism",
        "dossier",
        "dossier_section",
        "segment"
      ]
    },
    "operation": {
      "type": "string",
      "enum": ["create", "enrich"],
      "description": "Create a new artifact, or enrich an existing artifact after owner approval."
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "The mechanism, pack, or segment id the proposal targets."
    },
    "payload": true,
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provenanceItem" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "proposed_by": {
      "type": "string",
      "minLength": 1,
      "description": "Pipeline run id."
    },
    "proposed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "edited",
        "held_low_confidence",
        "held_non_transferable"
      ]
    },
    "hold_reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "below_confidence_floor",
            "no_material_enrichment",
            "not_transferable"
          ]
        },
        { "type": "null" }
      ]
    },
    "transferability": { "$ref": "#/$defs/transferabilityVerdict" },
    "verdict_unavailable": { "$ref": "#/$defs/transferabilityVerdictUnavailable" },
    "decided_by": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "decided_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "decision_note": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "required": [
    "id",
    "type",
    "operation",
    "target",
    "payload",
    "provenance",
    "confidence",
    "proposed_by",
    "proposed_at",
    "status",
    "hold_reason",
    "decided_by",
    "decided_at",
    "decision_note"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["held_low_confidence", "held_non_transferable"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "held_low_confidence" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "hold_reason": {
                  "type": "string",
                  "enum": ["below_confidence_floor", "no_material_enrichment"]
                }
              }
            },
            "else": {
              "description": "A transferability hold states the verdict that produced it. A held record with no stored reasoning is the irreversible-filter-without-diagnostics failure the hold exists to avoid. It can never carry verdict_unavailable: a claim nobody judged cannot have been refused.",
              "properties": {
                "hold_reason": { "const": "not_transferable" },
                "transferability": { "$ref": "#/$defs/transferabilityVerdict" },
                "verdict_unavailable": false
              },
              "required": ["transferability"]
            }
          }
        ]
      },
      "else": {
        "properties": { "hold_reason": { "type": "null" } }
      }
    },
    {
      "description": "A proposal carries a verdict or a reason there is none — never both. The two say incompatible things about the same pass, and a record asserting both is a bug in whatever wrote it, not a state to interpret.",
      "dependentSchemas": {
        "transferability": { "properties": { "verdict_unavailable": false } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "effect" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://ventora.dev/motivation-engine/effect.schema.json"
          }
        }
      }
    },
    {
      "description": "The transferability pass only ever judges effect proposals (transferabilityClaimOfProposal returns null for every other type), so a non-effect proposal claiming its verdict was unavailable is recording a failure that could not have happened.",
      "if": {
        "properties": { "type": { "not": { "const": "effect" } } },
        "required": ["type"]
      },
      "then": { "properties": { "verdict_unavailable": false } }
    },
    {
      "if": {
        "properties": { "type": { "const": "realization" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://ventora.dev/motivation-engine/realization.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "interaction" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://ventora.dev/motivation-engine/interaction.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "mechanism" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://ventora.dev/motivation-engine/mechanism.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "dossier" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/dossierDraft" }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "dossier_section" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/dossierSection" }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "segment" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/segment" }
        }
      }
    }
  ],
  "$defs": {
    "doi": {
      "type": "string",
      "pattern": "^10\\.\\d{4,9}/\\S+$"
    },
    "transferabilityVerdict": {
      "description": "What the transferability rules decided about this claim, and why (D-160). Judged at extraction from the claim alone — fact, boundary, source title — never from the source text, which is what makes it replayable offline from this file with no corpus and no network. A refusal never drops the candidate and never writes reader coverage: it produces status=held_non_transferable carrying this verdict, so the record and its reasoning both survive. Absent on everything written before the pass existed and on everything hand-authored, because a verdict invented for a claim no rule ever judged would be an assertion wearing the pipeline's authority.",
      "type": "object",
      "properties": {
        "ruleset_version": {
          "description": "Which version of the rules produced this verdict. A stored verdict is only interpretable next to them.",
          "type": "integer",
          "minimum": 1
        },
        "transferable": { "type": "boolean" },
        "escalated_by_warning_pair": {
          "description": "True when no single check refused and the verdict turned on the subject+population warning pair — the one scoring rule the owner did not specify outright, kept separable so its effect can always be measured on its own.",
          "type": "boolean"
        },
        "checks": {
          "description": "All four checks, always, in order: subject, variable, direction, population.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "string",
                "enum": ["subject", "variable", "direction", "population"]
              },
              "outcome": {
                "description": "fail refuses on its own; warn refuses only in company; pass admits.",
                "type": "string",
                "enum": ["pass", "warn", "fail"]
              },
              "reason": { "type": "string", "minLength": 1 },
              "identified_lever": {
                "description": "The interface lever the check named, when it named one (ruleset v2 VARIABLE, D-162): the product surface this claim can act on. A non-empty string when variable passed, null when it found none, and absent for the deterministic v1 checks. This field is what keeps a v2 verdict auditable offline even though its VARIABLE outcome cannot be recomputed without the model that produced it.",
                "type": ["string", "null"],
                "minLength": 1
              }
            },
            "required": ["check", "outcome", "reason"],
            "additionalProperties": false
          }
        },
        "modifiers_flagged": {
          "description": "The non-VARIABLE checks that flagged, under ruleset v3 (D-165). In v3 these are confidence modifiers rather than refusals: SUBJECT, DIRECTION and POPULATION still run and still state their reasons, but only VARIABLE can refuse. Recorded so the flag survives on an ADMITTED verdict — v3 exists because those three were refusing claims whose lever VARIABLE had already named, and a modifier that vanished on admission would hide the signal that motivated the change. Not required: absent on v1 and v2 verdicts, where these checks could refuse and escalated_by_warning_pair describes the scoring instead. variable is excluded from the enum by construction — the only check that can refuse can never be a modifier.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["subject", "direction", "population"]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "ruleset_version",
        "transferable",
        "escalated_by_warning_pair",
        "checks"
      ],
      "additionalProperties": false
    },
    "transferabilityVerdictUnavailable": {
      "description": "Present exactly when the transferability pass ran on this claim and could not reach a verdict (D-162 fails open). The claim was admitted to review anyway — a model outage must never silently bury a grounded claim — and this records that nobody judged it. It exists because the first fail-open expressed itself as an ABSENT transferability field, which is also what a pre-D-160 proposal and a non-effect proposal look like: an unjudged item was indistinguishable from a judged one and nothing counted it. Mutually exclusive with transferability. Its own absence proves nothing, since records the pass never touched carry neither field.",
      "type": "object",
      "properties": {
        "ruleset_version": {
          "description": "The ruleset being applied when it could not produce a verdict.",
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "description": "Which failure occurred. Split by cause because a run that exhausted its token cap and a run whose model was unreachable produce the same count and demand different responses. answer_truncated is split from malformed_answer for the same reason: one is the model failing the format, the other is the model following it and being cut off by a ceiling we set.",
          "type": "string",
          "enum": [
            "no_model_id",
            "per_run_token_cap",
            "monthly_token_cap",
            "transport_error",
            "malformed_answer",
            "answer_truncated"
          ]
        },
        "detail": {
          "description": "Optional specifics — an HTTP status, the cap that would have been crossed. Never the model's raw output: a malformed answer is not evidence, and a proposal is not where it belongs.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["ruleset_version", "reason"],
      "additionalProperties": false
    },
    "provenanceItem": {
      "oneOf": [
        { "$ref": "#/$defs/evidenceProvenanceItem" },
        { "$ref": "#/$defs/realizationProvenanceItem" },
        { "$ref": "#/$defs/inferenceProvenanceItem" }
      ]
    },
    "evidenceProvenanceItem": {
      "type": "object",
      "properties": {
        "corpus_kind": { "const": "evidence" },
        "mechanism_id": { "type": "string", "pattern": "^[A-Z]{2}-\\d{2}$" },
        "corpus_record_id": { "type": "string", "pattern": "^cr_[a-f0-9]{24}$" },
        "doi": {
          "anyOf": [
            { "$ref": "#/$defs/doi" },
            { "type": "null" }
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "quote_or_locus": { "type": "string", "minLength": 1 },
        "source_span": { "$ref": "#/$defs/provenanceSourceSpan" },
        "span_role": { "$ref": "#/$defs/spanRole" }
      },
      "required": ["mechanism_id", "corpus_record_id", "doi", "title", "quote_or_locus"],
      "additionalProperties": false
    },
    "spanRole": {
      "description": "What the quoted span is DOING in the source it was cut from (D-129). Asserted by the extraction pass — the only pass that reads a record — then checked against the source text: a span inside a labelled BACKGROUND or METHOD section cannot be a finding, and a span the same source later reverses is not one either. Only span_role=finding reports what the cited source observed, and an item whose citations carry no finding is refused. Optional so items written before D-129 stay valid; required in code of anything the extraction pipeline produces.",
      "type": "string",
      "enum": ["background", "hypothesis", "method", "finding", "limitation"]
    },
    "provenanceSourceSpan": {
      "description": "Where the quote sits in its source record, and which version of that record the offsets were resolved against (D-110). start/end are end-exclusive character offsets into lib/proposal-quality evidenceSourceText(record), so slicing that string at them re-derives the quote. source_text_sha256 pins the exact text: without it a re-harvested or re-normalised record silently relocates the offsets onto different words, so a mismatch marks the span STALE as a named condition instead. Optional so pre-D-110 hand-authored records stay valid; required in code of anything the extraction pipeline produces.",
      "type": "object",
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "source_text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "required": ["start", "end", "source_text_sha256"],
      "additionalProperties": false
    },
    "realizationProvenanceItem": {
      "type": "object",
      "properties": {
        "corpus_kind": { "const": "realization" },
        "mechanism_id": { "type": "string", "pattern": "^[A-Z]{2}-\\d{2}$" },
        "corpus_record_id": { "type": "string", "pattern": "^rr_[a-f0-9]{24}$" },
        "source_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "quote_or_locus": { "type": "string", "minLength": 1 },
        "contributed_by": { "type": ["string", "null"], "minLength": 1 }
      },
      "required": [
        "corpus_kind",
        "mechanism_id",
        "corpus_record_id",
        "source_id",
        "title",
        "quote_or_locus",
        "contributed_by"
      ],
      "additionalProperties": false
    },
    "inferenceProvenanceItem": {
      "description": "The transfer step recorded as provenance (D-112): a realization whose pattern was inferred from an effect measured in another domain carries the effect's own statement verbatim, with no source_span, because that statement is an L2 record's text rather than a slice of a harvested document. span_absent_reason says so in the data. Mirrors realizations/realization.schema.json.",
      "type": "object",
      "properties": {
        "corpus_kind": { "const": "inference" },
        "mechanism_id": { "type": "string", "pattern": "^[A-Z]{2}-\\d{2}$" },
        "corpus_record_id": { "type": "string", "pattern": "^cr_[a-f0-9]{24}$" },
        "effect_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "quote_or_locus": { "type": "string", "minLength": 1 },
        "span_absent_reason": { "const": "no direct span — inferred from effect" }
      },
      "required": [
        "corpus_kind",
        "mechanism_id",
        "corpus_record_id",
        "effect_id",
        "title",
        "quote_or_locus",
        "span_absent_reason"
      ],
      "additionalProperties": false
    },
    "artifactType": {
      "type": "string",
      "enum": [
        "paywall",
        "cancellation_flow",
        "retention_push",
        "checkout",
        "email",
        "pricing_page",
        "dashboard_widget",
        "onboarding",
        "landing_hero"
      ]
    },
    "implementation": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "effect_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "artifact_types": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifactType" }
        },
        "product_requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "generation_directive": { "type": "string", "minLength": 1 },
        "copy_formulas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "observed_effects": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Measured product outcomes from telemetry, not L2 effects."
        }
      },
      "required": [
        "id",
        "artifact_types",
        "product_requirements",
        "generation_directive",
        "copy_formulas",
        "metrics",
        "observed_effects"
      ],
      "additionalProperties": false
    },
    "axis": {
      "type": "object",
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 3 },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "required": ["score", "rationale"],
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "properties": {
        "evidence": { "$ref": "#/$defs/axis" },
        "product_applicability": { "$ref": "#/$defs/axis" },
        "measurability": { "$ref": "#/$defs/axis" },
        "orthogonality": { "$ref": "#/$defs/axis" },
        "safety": { "$ref": "#/$defs/axis" }
      },
      "required": [
        "evidence",
        "product_applicability",
        "measurability",
        "orthogonality",
        "safety"
      ],
      "additionalProperties": false
    },
    "evidenceSource": {
      "type": "object",
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "doi": { "type": "string", "minLength": 1 }
      },
      "required": ["ref"],
      "additionalProperties": false
    },
    "dossierDraftAxis": {
      "description": "One drafted axis (D-085): either fully grounded (score + rationale + at least one literature provenance item) or explicitly unscored (nulls, empty provenance) — flagged for owner judgement, never guessed. Unscored axes block approval until the owner edits them.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 3 },
            "rationale": { "type": "string", "minLength": 1 },
            "provenance": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/evidenceProvenanceItem" }
            }
          },
          "required": ["score", "rationale", "provenance"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "score": { "type": "null" },
            "rationale": { "type": "null" },
            "provenance": { "type": "array", "maxItems": 0 }
          },
          "required": ["score", "rationale", "provenance"],
          "additionalProperties": false
        }
      ]
    },
    "dossierDraft": {
      "description": "Full machine-drafted dossier (D-085). total/verdict/decided_by/date are absent by design — computed and stamped at owner approval. Never auto-approves.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^DOS-[A-Z]{2}-\\d{2}$" },
        "mechanism_id": { "type": "string", "pattern": "^[A-Z]{2}-\\d{2}$" },
        "scores": {
          "type": "object",
          "properties": {
            "evidence": { "$ref": "#/$defs/dossierDraftAxis" },
            "product_applicability": { "$ref": "#/$defs/dossierDraftAxis" },
            "measurability": { "$ref": "#/$defs/dossierDraftAxis" },
            "orthogonality": { "$ref": "#/$defs/dossierDraftAxis" },
            "safety": { "$ref": "#/$defs/dossierDraftAxis" }
          },
          "required": [
            "evidence",
            "product_applicability",
            "measurability",
            "orthogonality",
            "safety"
          ],
          "additionalProperties": false
        },
        "core_condition": { "type": "string", "minLength": 1 },
        "dissent": { "type": "string", "minLength": 1 },
        "evidence_sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceSource" }
        },
        "notes": { "type": "string" }
      },
      "required": [
        "id",
        "mechanism_id",
        "scores",
        "core_condition",
        "dissent",
        "evidence_sources"
      ],
      "additionalProperties": false
    },
    "dossierSection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": { "const": "scores" },
            "value": { "$ref": "#/$defs/scores" }
          },
          "required": ["field", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": { "const": "total" },
            "value": { "type": "integer", "minimum": 0, "maximum": 15 }
          },
          "required": ["field", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": { "const": "core_condition" },
            "value": { "type": "string", "minLength": 1 }
          },
          "required": ["field", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": { "const": "dissent" },
            "value": { "type": "string", "minLength": 1 }
          },
          "required": ["field", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": { "const": "evidence_sources" },
            "value": {
              "type": "array",
              "items": { "$ref": "#/$defs/evidenceSource" }
            }
          },
          "required": ["field", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": { "const": "verdict" },
            "value": {
              "type": "string",
              "enum": ["incubating", "core", "rejected", "hold"]
            }
          },
          "required": ["field", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": { "const": "decided_by" },
            "value": { "type": "string", "minLength": 1 }
          },
          "required": ["field", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": { "const": "date" },
            "value": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": ["field", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": { "const": "notes" },
            "value": { "type": "string" }
          },
          "required": ["field", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "enum": ["flag_lowest_admitted", "flag_completes_core"]
            },
            "value": { "type": "boolean" }
          },
          "required": ["field", "value"],
          "additionalProperties": false
        }
      ]
    },
    "segment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "group": {
          "type": "string",
          "enum": ["business-model", "form", "audience", "usage-rhythm"]
        },
        "definition": { "type": "string", "minLength": 1 },
        "status": { "const": "active" },
